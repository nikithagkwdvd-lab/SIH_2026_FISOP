# Supabase PostgreSQL Connection String for your project
# Driver format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.tsclxzjxlphncxvhyrsp.supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Keycloak OIDC Authentication Settings
JWT_SECRET_KEY=dev_secret_key_government_interoperability_2026
JWT_ALGORITHM=HS256
KEYCLOAK_ISSUER=http://localhost:8080/realms/government-interoperability
KEYCLOAK_AUDIENCE=interoperability-api

# Environment-Based Legacy Department Microservice URLs
REVENUE_API_URL=http://localhost:8001
LAND_API_URL=http://localhost:8002
WELFARE_API_URL=http://localhost:8003

# Connector Circuit Breaker & Finite Timeout Settings
DEPARTMENT_CONNECT_TIMEOUT=3.0
DEPARTMENT_READ_TIMEOUT=5.0
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=10.0

# Redis-Less In-Memory Rate Limiter Settings
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# AI Schema Onboarding & Mapping Governance Settings
AI_PROVIDER=mock
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your-gemini-api-key-here
MOCK_AI=false

