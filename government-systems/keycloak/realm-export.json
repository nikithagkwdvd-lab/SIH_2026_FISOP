{
  "realm": "government-interoperability",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "sslRequired": "external",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "interoperability-api",
      "name": "Government Digital Interoperability API",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000",
        "http://localhost:8000/*",
        "http://localhost:8000/docs"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8000",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "department_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "department_code",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "department_code",
            "jsonType.label": "String"
          }
        },
        {
          "name": "canonical_citizen_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "canonical_citizen_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "canonical_citizen_id",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "CITIZEN",
        "description": "Citizen role"
      },
